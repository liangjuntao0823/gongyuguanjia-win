<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ApartmentManagerWin.App"
             xmlns:local="using:ApartmentManagerWin"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackground" Color="#F4F5F9" />
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#EEF0F6" />
                    <SolidColorBrush x:Key="SidebarHover" Color="#E2E6F0" />
                    <SolidColorBrush x:Key="SidebarActive" Color="#2F6BFF" />
                    <SolidColorBrush x:Key="SidebarActiveText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#1F2329" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#7A8190" />
                    <SolidColorBrush x:Key="CardBorder" Color="#E5E7EE" />
                    <SolidColorBrush x:Key="Accent" Color="#2F6BFF" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#EAF0FF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#22A06B" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#E8820C" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#D64545" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#EDEFF4" />
                    <SolidColorBrush x:Key="RowHover" Color="#F5F7FC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackground" Color="#17181C" />
                    <SolidColorBrush x:Key="CardBackground" Color="#23252B" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#1E2025" />
                    <SolidColorBrush x:Key="SidebarHover" Color="#2A2D35" />
                    <SolidColorBrush x:Key="SidebarActive" Color="#3D7BFF" />
                    <SolidColorBrush x:Key="SidebarActiveText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#E8EAEF" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#9AA1AE" />
                    <SolidColorBrush x:Key="CardBorder" Color="#33363E" />
                    <SolidColorBrush x:Key="Accent" Color="#3D7BFF" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#2A3A5E" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#34C27E" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F2A03D" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#E56767" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#2E3138" />
                    <SolidColorBrush x:Key="RowHover" Color="#2A2D35" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBox, NumericUpDown, ComboBox, DatePicker, TimePicker">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Application.Styles>
</Application>
