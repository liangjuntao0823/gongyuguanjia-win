<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.HousesView"
             x:DataType="vm:HousesViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶栏：统计 + 搜索 + 状态 + 户型多选 + 新增 -->
        <StackPanel Grid.Row="0" Margin="20,16,20,0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="房源" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBox Width="240" Watermark="搜索房号 / 房东" Text="{Binding SearchText}" />
                    <ComboBox Width="110" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="批量导入" Click="OnImportHouses" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="批量导入" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                    <Button Content="＋ 新增房源" Classes="primary" Click="OnAddHouse"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="新增房源" VerticalAlignment="Center" Foreground="White"/></StackPanel></Button>
                    <Button Content="同步媒体" Click="OnSyncMedia" Classes=""><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="同步媒体" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                </StackPanel>
            </Grid>

            <!-- 户型多选芯片 -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="户型：" Classes="muted" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding LayoutChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}"
                                          Click="OnToggleLayout"
                                          CornerRadius="14" Padding="10,4" FontSize="12.5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding StatText}" Classes="muted" />
        </StackPanel>

        <!-- 房源列表（列表式卡片） -->
        <ScrollViewer Grid.Row="1" Margin="20,10,20,20" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,4" Padding="14,10"
                                Background="{DynamicResource CardBackground}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <!-- 第一行：房号 + 状态徽标 + 户型 + 房东 + 媒体标识 -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding RoomNo}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <Border CornerRadius="9" Padding="7,2" Background="#EAF0FF">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="Background" Value="#EAF0FF" />
                                            </Style>
                                        </Border.Styles>
                                        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="#2F6BFF" />
                                    </Border>
                                    <TextBlock Text="{Binding Layout}" Classes="muted" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Landlord}" Classes="muted" VerticalAlignment="Center" />
                                    <Border CornerRadius="9" Padding="7,2" Background="{DynamicResource AccentSoft}" IsVisible="{Binding HasMedia}">
                                        <TextBlock Text="有实拍图" FontSize="11.5" Foreground="{DynamicResource Accent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Price}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />

                                <!-- 第二行：备注 + 云徽标 -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Remark}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" CornerRadius="10" Padding="6,2" Background="{DynamicResource AccentSoft}" IsVisible="{Binding IsCloudBadge}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CloudBadge}" FontSize="11.5" Foreground="{DynamicResource Accent}" />
                                    </Border>
                                </Grid>

                                <!-- 第三行：操作区（桌面适配：按钮直接可见，不再藏右键菜单） -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <Button Content="详情" Click="OnViewDetailBtn" Tag="{Binding House}" Padding="12,5" FontSize="12.5" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="详情" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                    <Button Content="编辑" Click="OnEditHouseBtn" Tag="{Binding House}" Padding="12,5" FontSize="12.5" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="编辑" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                    <Button Content="分享给客户" Click="OnShareMasked" Tag="{Binding House}" Padding="12,5" FontSize="12.5"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="分享给客户" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                    <Button Content="分享给同事" Click="OnShareFull" Tag="{Binding House}" Padding="12,5" FontSize="12.5" />
                                    <Button Content="删除" Click="OnDeleteHouseBtn" Tag="{Binding House}" Padding="12,5" FontSize="12.5" Foreground="{DynamicResource DangerBrush}" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="删除" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
