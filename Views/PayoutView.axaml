<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.PayoutView"
             x:DataType="vm:PayoutViewModel">

    <TabControl>
        <TabItem Header="包租合同">
            <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="包租" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ 新增包租合同" Classes="primary" Click="OnAddPayout"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="新增包租合同" VerticalAlignment="Center" Foreground="White"/></StackPanel></Button>
                    <Button Content="导出 Excel" Click="OnExportExcel"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导出 Excel" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                    <Button Content="导出图片" Click="OnExportImage" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导出图片" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ComboBox Width="120" ItemsSource="{Binding StatusFilter}" SelectedItem="{Binding SelectedFilter}" />
                <TextBlock Grid.Column="2" Text="{Binding StatText}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- 列表式卡片 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,4" Padding="14,10">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="查看详情" Click="OnViewDetail" Tag="{Binding Payout}" />
                                    <MenuItem Header="编辑" Click="OnEditPayout" Tag="{Binding Payout}" />
                                    <MenuItem Header="删除" Click="OnDeletePayout" Tag="{Binding Payout}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                <TextBlock Text="{Binding RoomNumber}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Width="110" />
                                <TextBlock Grid.Column="1" Text="{Binding Manager}" Classes="muted" Width="90" />
                                <TextBlock Grid.Column="2" Text="{Binding Rent}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Width="120" />
                                <TextBlock Grid.Column="3" Text="{Binding PaymentMethod}" Classes="muted" Width="90" />
                                <TextBlock Grid.Column="4" Text="{Binding DueDay, StringFormat='{}每{0}日付'}" Classes="muted" Width="90" />
                                <TextBlock Grid.Column="5" Text="{Binding LeaseRange}" Classes="muted" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
        </TabItem>
        <TabItem Header="包租核算">
            <Grid RowDefinitions="Auto,*" Margin="20">
                <StackPanel Grid.Row="0" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="包租核算" Classes="pageTitle" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="＋ 新增核算" Classes="primary" Click="OnAddPackage"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="新增核算" VerticalAlignment="Center" Foreground="White"/></StackPanel></Button>
                            <Button Content="导出 Excel" Click="OnExportPackageExcel"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导出 Excel" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="0" Text="{Binding PackageStatText}" Classes="muted" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding PackageRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Margin="0,4" Padding="14,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding RoomNumber}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PackagePeriod}" Classes="muted" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button Content="编辑" Classes="smallBtn" Tag="{Binding Record}" Click="OnEditPackage" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="编辑" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                                <Button Content="删除" Classes="smallBtn" Tag="{Binding Record}" Click="OnDeletePackage" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="删除" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal">
                                            <Border Classes="miniPill" Margin="0,0,6,4"><TextBlock Text="{Binding PackageAmountText}" /></Border>
                                            <Border Classes="miniPill" Margin="0,0,6,4"><TextBlock Text="{Binding DailyCostText}" /></Border>
                                            <Border Classes="miniPill" Margin="0,0,6,4"><TextBlock Text="{Binding VacancyCostText}" /></Border>
                                            <Border Classes="miniPill" Margin="0,0,6,4"><TextBlock Text="{Binding RentalIncomeText}" /></Border>
                                            <Border Classes="miniPill" Margin="0,0,6,4"><TextBlock Text="{Binding NetProfitText}" Foreground="{Binding NetProfitBrush}" /></Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Notes}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
