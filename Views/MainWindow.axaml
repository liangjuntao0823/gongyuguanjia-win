<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApartmentManagerWin.ViewModels"
        xmlns:local="using:ApartmentManagerWin"
        x:Class="ApartmentManagerWin.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="公寓管家"
        Width="1360" Height="860"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"><Window.Resources>
            <local:NavBgConverter x:Key="NavBg" />
            <local:NavFgConverter x:Key="NavFg" />
            <local:NavIconBgConverter x:Key="NavIconBg" />
            <local:NavBarConverter x:Key="NavBar" />
            <local:NavWeightConverter x:Key="NavWeight" />
        </Window.Resources>


    <DockPanel Background="{DynamicResource PageBackground}">

        <!-- 顶部条 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <TextBlock Text="寓" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="公寓管家" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VersionText}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="10" Value="{Binding SyncProgress}" IsVisible="{Binding IsSyncingVisible}" />
                    <TextBlock Text="{Binding SyncStatusText}" Classes="muted" VerticalAlignment="Center" />
                    <Button Content="立即同步" Classes="primary" Command="{Binding SyncNowCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="立即同步" VerticalAlignment="Center" Foreground="White"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 全局提示中心（根层级横幅：任何界面可见、可点击关闭；iOS v1.76 防卡死等价） -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NotifyItems}" Margin="12,8,12,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" CornerRadius="10" Padding="14,10"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource WarningBrush}" />
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DismissNotifyCommand}"
                                    CommandParameter="{Binding}" Padding="8,4" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <!-- 左侧导航 -->
            <Grid ColumnDefinitions="Auto,4,*">
                <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" MinWidth="150" MaxWidth="240" Padding="10">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,2"
                                        CornerRadius="10"
                                        Background="{Binding IsSelected, Converter={StaticResource NavBg}}"
                                        Foreground="{Binding IsSelected, Converter={StaticResource NavFg}}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateToCommand}"
                                        CommandParameter="{Binding Key}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="{Binding IsSelected, Converter={StaticResource NavIconBg}}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding IsSelected, Converter={StaticResource NavFg}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="{Binding IsSelected, Converter={StaticResource NavWeight}}" Foreground="{Binding IsSelected, Converter={StaticResource NavFg}}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Width="4" Height="22" CornerRadius="2" Background="{Binding IsSelected, Converter={StaticResource NavBar}}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="利保米兰公馆 · 二房东工作台" Classes="muted" FontSize="11" Margin="8,14,8,6" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource CardBorder}" HorizontalAlignment="Stretch" />

                <!-- 内容区：懒加载页面 -->
                <Border Grid.Column="2" Background="{DynamicResource PageBackground}" Padding="0">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
