<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApartmentManagerWin.ViewModels"
        x:Class="ApartmentManagerWin.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="公寓管家"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <DockPanel Background="{DynamicResource PageBackground}">

        <!-- 顶部条 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <TextBlock Text="寓" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="公寓管家" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="Windows 版" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="10" Value="{Binding SyncProgress}" IsVisible="{Binding IsSyncingVisible}" />
                    <TextBlock Text="{Binding SyncStatusText}" Classes="muted" VerticalAlignment="Center" />
                    <Button Content="立即同步" Classes="primary" Command="{Binding SyncNowCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <!-- 左侧导航（可缩窄：GridSplitter） -->
            <Grid ColumnDefinitions="Auto,4,*">
                <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" MinWidth="150" MaxWidth="260" Padding="10">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,2"
                                        CornerRadius="8"
                                        Background="{DynamicResource SidebarBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateToCommand}"
                                        CommandParameter="{Binding Key}">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="{DynamicResource SidebarBackground}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource CardBorder}" HorizontalAlignment="Stretch" />

                <!-- 内容区：懒加载页面 -->
                <Border Grid.Column="2" Background="{DynamicResource PageBackground}" Padding="0">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
