<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApartmentManagerWin.Views.PayoutDetailDialog"
        Title="包租详情" Width="680" Height="720"
        WindowStartupLocation="CenterOwner" MinWidth="600" MinHeight="540"
        Background="{DynamicResource PageBackground}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="编辑" Click="OnEdit" />
            <Button Content="关闭" Click="OnClose" Classes="ghost" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock x:Name="TitleText" Classes="pageTitle" />

                <!-- 分组1：合同信息 -->
                <Border Classes="card" Padding="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="合同信息" Classes="sectionTitle" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="包租人" Classes="muted" /><TextBlock x:Name="ManagerText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Column="2" Text="户型" Classes="muted" /><TextBlock Grid.Column="3" x:Name="UnitText" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Row="1" Text="付款方式" Classes="muted" /><TextBlock Grid.Row="1" Grid.Column="1" x:Name="PayText" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="租金" Classes="muted" /><TextBlock Grid.Row="1" Grid.Column="3" x:Name="RentText" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Text="押金" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="1" x:Name="DepositText" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="免租期" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="3" x:Name="FreeText" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Row="3" Text="交租日" Classes="muted" /><TextBlock Grid.Row="3" Grid.Column="1" x:Name="DueDayText" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="租期时长" Classes="muted" /><TextBlock Grid.Row="3" Grid.Column="3" x:Name="DurationText" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="4" x:Name="LeaseRangeText" Classes="muted" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组2：水电底数 -->
                <Border Classes="card" Padding="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="水电底数" Classes="sectionTitle" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <TextBlock Text="水表底数" Classes="muted" /><TextBlock x:Name="WaterText" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Grid.Column="2" Text="电表底数" Classes="muted" /><TextBlock Grid.Column="3" x:Name="ElectricText" Foreground="{DynamicResource TextPrimary}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分组3：打租记录 -->
                <Border Classes="card" Padding="14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="打租记录" Classes="sectionTitle" />
                            <TextBlock x:Name="PaySummaryText" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="PayList" />
                    </StackPanel>
                </Border>

                <!-- 分组4：水电结算 -->
                <Border Classes="card" Padding="14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="水电结算" Classes="sectionTitle" />
                            <TextBlock x:Name="UtilSummaryText" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="UtilList" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
