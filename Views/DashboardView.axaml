<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="14">

            <!-- 顶栏用户区（对齐 Mac/iOS 工作台顶栏） -->
            <Border Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding UserTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding UserSubtitle}" Classes="muted" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✎ 编辑" Classes="toolbar" VerticalAlignment="Center" Click="OnEditUserCard"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="编辑" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                </Grid>
            </Border>

            <!-- v1.0：本月倒计时（对齐 iOS） -->
            <Border Classes="card" Padding="14,10" Background="{DynamicResource AccentSoft}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="本月还剩" Classes="sectionTitle" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DaysLeftInMonth}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="天" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HoursLeftInMonth}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="小时，加油" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- KPI 行（8 卡，对齐 iOS KPI 看板） -->
            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" Margin="0,4,0,0">
                <Border Classes="card" Margin="0,0,8,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="房源总数" Classes="muted" />
                        <TextBlock Text="{Binding HouseCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Margin="8,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="待租房源" Classes="muted" />
                        <TextBlock Text="{Binding PendingRentCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Margin="8,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="在租房源" Classes="muted" />
                        <TextBlock Text="{Binding RentedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="card" Margin="8,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="本月成交" Classes="muted" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0:0.##} 元"><Binding Path="MonthDealAmount"/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="card" Margin="8,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="本月收租" Classes="muted" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0:0.##} 元"><Binding Path="MonthRentIncome"/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Classes="card" Margin="8,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="本月利润" Classes="muted" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0:0.##} 元"><Binding Path="MonthProfit"/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="card" Margin="8,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="本月中介费" Classes="muted" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0:0.##} 元"><Binding Path="MonthAgentFee"/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="7" Classes="card" Margin="8,0,0,0" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="30天内到期" Classes="muted" />
                        <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                            <TextBlock Text="管理" Classes="muted" FontSize="11" />
                            <TextBlock Text="{Binding ManageCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="套 · 包租" Classes="muted" FontSize="11" />
                            <TextBlock Text="{Binding PackageCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="份" Classes="muted" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 快捷操作 -->
            <Border Classes="card" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="快捷操作" Classes="sectionTitle" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Classes="primary" Click="OnAddHouse"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White" /><TextBlock Text="新增房源" VerticalAlignment="Center" Foreground="White" /></StackPanel></Button>
                    <Button Classes="primary" Click="OnAddDeal"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White" /><TextBlock Text="新增成交" VerticalAlignment="Center" Foreground="White" /></StackPanel></Button>
                    <Button Click="OnAddIncome"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /><TextBlock Text="新增收入" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /></StackPanel></Button>
                    <Button Click="OnAddExpense"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /><TextBlock Text="新增支出" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /></StackPanel></Button>
                    <Button Click="OnAddPayout"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /><TextBlock Text="新增包租" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /></StackPanel></Button>
                    <Button Click="OnAddTodo"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /><TextBlock Text="新增待办" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /></StackPanel></Button>
                    <Button Classes="primary" Click="OnQuickCollectToday"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White" /><TextBlock Text="一键收今日到期" VerticalAlignment="Center" Foreground="White" /></StackPanel></Button>
                    <Button Click="OnGoRent"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /><TextBlock Text="去收租" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /></StackPanel></Button>
                    <Button Click="OnGoPayout"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /><TextBlock Text="去包租" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /></StackPanel></Button>
                    <Button Click="OnGoTodos"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /><TextBlock Text="去待办" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" /></StackPanel></Button>
                </StackPanel>
            </Border>

            <!-- 未收租提醒（2 列） -->
            <Border Classes="card" Padding="14,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="未收租提醒" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="*,*">
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding RentDueCards}" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Rent, StringFormat='{}{0}元/月'}" Classes="muted" HorizontalAlignment="Left" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="2" Foreground="{DynamicResource WarningBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}每{1}日  {0:0}元">
                                                        <Binding Path="Rent" />
                                                        <Binding Path="DueDay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding RentDueCards2}" Margin="6,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Rent, StringFormat='{}{0}元/月'}" Classes="muted" HorizontalAlignment="Left" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="2" Foreground="{DynamicResource WarningBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}每{1}日  {0:0}元">
                                                        <Binding Path="Rent" />
                                                        <Binding Path="DueDay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 包租付租提醒 -->
            <Border Classes="card" Padding="14,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="包租付租提醒" Classes="sectionTitle" />
                    <ItemsControl ItemsSource="{Binding PayoutDueCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Grid.Column="1" Classes="muted" HorizontalAlignment="Left" Margin="10,0,0,0" Text="包租" />
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource WarningBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}每{1}日 付{0:0}元">
                                                    <Binding Path="Amount" />
                                                    <Binding Path="DueDay" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- v1.0：即将到期（30天内租期到期） -->
            <Border Classes="card" Padding="14,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="即将到期" Classes="sectionTitle" />
                    <ItemsControl ItemsSource="{Binding ExpiringSoon}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding RoomNumber}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding LeaseEndText}" Classes="muted" />
                                        <TextBlock Text="{Binding DaysText}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 今日待办入口 -->
            <Border Classes="card" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="待办（未完成）" Classes="sectionTitle" />
                        <TextBlock Text="{Binding OpenTodoCount}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TodayTodos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="☐" Foreground="{DynamicResource Accent}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
