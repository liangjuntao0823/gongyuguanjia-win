<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.DealsView"
             x:DataType="vm:DealsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <!-- 顶栏 -->
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="成交" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ 新增成交" Classes="primary" Click="OnAddDeal"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="新增成交" VerticalAlignment="Center" Foreground="White"/></StackPanel></Button>
                    <Button Content="导出 Excel" Click="OnExportExcel" Classes=""><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导出 Excel" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                    <Button Content="导出图片" Click="OnExportImage" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导出图片" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                    <Button Content="导入 Excel" Click="OnImportExcel" Classes=""><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导入 Excel" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBox Width="260" Watermark="搜索房号/房东/户型/客户..." Text="{Binding SearchText}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="110" Margin="8,0,0,0" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
                <ComboBox Grid.Column="2" Width="100" Margin="8,0,0,0" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" />
                <TextBlock Grid.Column="3" Text="{Binding StatText}" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </StackPanel>

        <!-- 对齐 Mac：成交表格（成交日期/房号/房东/户型/租期/租金/押金/中介费/经办人/操作） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="成交日期" Binding="{Binding Date}" Width="100" />
                    <DataGridTextColumn Header="房号" Binding="{Binding RoomNumber}" Width="100" />
                    <DataGridTextColumn Header="房东" Binding="{Binding Landlord}" Width="70" />
                    <DataGridTextColumn Header="户型" Binding="{Binding UnitType}" Width="110" />
                    <DataGridTextColumn Header="租期" Binding="{Binding LeaseDuration}" Width="80" />
                    <DataGridTextColumn Header="租金/月" Binding="{Binding RentText}" Width="90" />
                    <DataGridTextColumn Header="押金" Binding="{Binding DepositText}" Width="90" />
                    <DataGridTextColumn Header="中介费" Binding="{Binding AgentFee, StringFormat='{}{0:0.##}'}" Width="80" />
                    <DataGridTextColumn Header="经办人" Binding="{Binding Manager}" Width="70" />
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="详情" Click="OnViewDetail" Tag="{Binding Deal}" Padding="10,3" FontSize="12" />
                                    <Button Content="删除" Click="OnDeleteDeal" Tag="{Binding Deal}" Padding="10,3" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</UserControl>
