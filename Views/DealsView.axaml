<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.DealsView"
             x:DataType="vm:DealsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <!-- 顶栏 -->
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="成交" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ 新增成交" Classes="primary" Click="OnAddDeal" />
                    <Button Content="导出 Excel" Click="OnExportExcel" />
                    <Button Content="导出图片" Click="OnExportImage" />
                    <Button Content="导入 Excel" Click="OnImportExcel" />
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                <ComboBox Width="120" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
                <ComboBox Grid.Column="1" Width="100" Margin="8,0,0,0" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" />
                <TextBlock Grid.Column="3" Text="{Binding StatText}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,4" Padding="14,10">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="编辑" Click="OnEditDeal" Tag="{Binding Deal}" />
                                    <MenuItem Header="删除" Click="OnDeleteDeal" Tag="{Binding Deal}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                <TextBlock Text="{Binding Date}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Width="110" />
                                <TextBlock Grid.Column="1" Text="{Binding RoomNumber}" Classes="muted" Width="90" />
                                <TextBlock Grid.Column="2" Text="{Binding Customer}" Classes="muted" Width="110" />
                                <TextBlock Grid.Column="3" Text="{Binding Type}" Foreground="{DynamicResource Accent}" Width="90" />
                                <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat='{}{0:0.##}元'}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Width="90" />
                                <TextBlock Grid.Column="5" Text="{Binding AgentFee, StringFormat='{}{0:0.##}元'}" Classes="muted" Width="80" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
