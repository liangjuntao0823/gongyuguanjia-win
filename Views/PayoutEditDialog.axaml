<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApartmentManagerWin.Views.PayoutEditDialog"
        Title="新增 / 编辑包租合同" Width="620" Height="760"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{DynamicResource PageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="10">
            <TextBlock x:Name="TitleText" Classes="pageTitle" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Row="0">
                    <TextBlock Text="房号" Classes="muted" />
                    <TextBox x:Name="RoomBox" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="包租人" Classes="muted" />
                    <TextBox x:Name="ManagerBox" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="户型" Classes="muted" />
                    <ComboBox x:Name="UnitBox">
                        <ComboBox.Items>
                            <ComboBoxItem Content="单间上层" />
                            <ComboBoxItem Content="单间下层" />
                            <ComboBoxItem Content="户型复式" />
                            <ComboBoxItem Content="中空复式" />
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="付款方式" Classes="muted" />
                    <ComboBox x:Name="PayBox">
                        <ComboBox.Items>
                            <ComboBoxItem Content="月付" />
                            <ComboBoxItem Content="季付" />
                            <ComboBoxItem Content="半年付" />
                            <ComboBoxItem Content="年付" />
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="年租金（元）" Classes="muted" />
                    <NumericUpDown x:Name="AnnualBox" Minimum="0" Maximum="9999999" Increment="1000" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="月租金（元，选填）" Classes="muted" />
                    <NumericUpDown x:Name="MonthlyBox" Minimum="0" Maximum="999999" Increment="100" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="押金（元）" Classes="muted" />
                    <NumericUpDown x:Name="DepositBox" Minimum="0" Maximum="999999" Increment="100" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <TextBlock Text="免租期（天）" Classes="muted" />
                    <NumericUpDown x:Name="FreeBox" Minimum="0" Maximum="365" Increment="1" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <TextBlock Text="租期开始" Classes="muted" />
                    <DatePicker x:Name="StartPicker" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1">
                    <TextBlock Text="租期结束" Classes="muted" />
                    <DatePicker x:Name="EndPicker" />
                </StackPanel>
                <StackPanel Grid.Row="5">
                    <TextBlock Text="交租日" Classes="muted" />
                    <NumericUpDown x:Name="DueDayBox" Minimum="1" Maximum="31" Increment="1" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1">
                    <TextBlock Text="租期时长" Classes="muted" />
                    <TextBox x:Name="DurationBox" Watermark="如 1年 / 2年" />
                </StackPanel>
                <StackPanel Grid.Row="6">
                    <TextBlock Text="水表底数" Classes="muted" />
                    <NumericUpDown x:Name="WaterBox" Minimum="0" Maximum="999999" Increment="1" FormatString="0.##" />
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="1">
                    <TextBlock Text="电表底数" Classes="muted" />
                    <NumericUpDown x:Name="ElectricBox" Minimum="0" Maximum="999999" Increment="1" FormatString="0.##" />
                </StackPanel>
                <StackPanel Grid.Row="7" Grid.ColumnSpan="2">
                    <TextBlock Text="备注" Classes="muted" />
                    <TextBox x:Name="NoteBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Classes="muted" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="取消" Click="OnCancel" Classes="ghost" />
                <Button Content="保存" Click="OnSave" Classes="primary" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
