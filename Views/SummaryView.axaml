<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.SummaryView"
             x:DataType="vm:SummaryViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="汇总" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding HideData}" Content="隐藏数据" VerticalAlignment="Center" />
                    <ComboBox Width="120" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
                    <ComboBox Width="100" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding StatText}" Classes="muted" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel Spacing="12">
                <!-- 对齐 Mac：5 KPI 卡 -->
                <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,4,0,0">
                    <Border Classes="kpi" Margin="0,0,5,0" Padding="14,14">
                        <StackPanel><TextBlock Text="成交" Classes="kpiLabel" /><TextBlock Text="{Binding DealCountText}" Classes="kpiValue" /><TextBlock Text="单" Classes="kpiLabel" HorizontalAlignment="Left" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="kpi" Margin="5,0" Padding="14,14">
                        <StackPanel><TextBlock Text="中介费" Classes="kpiLabel" /><TextBlock Text="{Binding AgentFeeText}" Classes="kpiValue" Foreground="{DynamicResource Accent}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="kpi" Margin="5,0" Padding="14,14">
                        <StackPanel><TextBlock Text="杂项收入" Classes="kpiLabel" /><TextBlock Text="{Binding MiscIncomeText}" Classes="kpiValue" Foreground="{DynamicResource SuccessBrush}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="kpi" Margin="5,0" Padding="14,14">
                        <StackPanel><TextBlock Text="杂项支出" Classes="kpiLabel" /><TextBlock Text="{Binding MiscExpenseText}" Classes="kpiValue" Foreground="{DynamicResource DangerBrush}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="kpi" Margin="5,0,0,0" Padding="14,14">
                        <StackPanel><TextBlock Text="净总收入" Classes="kpiLabel" /><TextBlock Text="{Binding NetIncomeText}" Classes="kpiValue" Foreground="{DynamicResource Accent}" /></StackPanel>
                    </Border>
                </Grid>

<!-- 月度明细（加大字体） -->
                <Border Classes="card" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="月度明细" Classes="sectionTitle" />
                        <ItemsControl ItemsSource="{Binding DetailRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Label}" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{Binding IsIncome, Converter={x:Static vm:BrushConverter.Income}}">
                                                <TextBlock.Text><MultiBinding StringFormat="{}{0:0.##} 元"><Binding Path="Amount"/></MultiBinding></TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
