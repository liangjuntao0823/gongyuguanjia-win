<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.SummaryView"
             x:DataType="vm:SummaryViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="汇总" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding HideData}" Content="隐藏数据" VerticalAlignment="Center" />
                    <ComboBox Width="120" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
                    <ComboBox Width="100" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding StatText}" Classes="muted" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel Spacing="12">
                <!-- 三大指标（加大字号） -->
                <Grid ColumnDefinitions="*,*,*">
                    <Border Classes="card" Margin="0,0,6,0" Padding="18,18">
                        <StackPanel>
                            <TextBlock Text="总收入" Classes="muted" />
                            <TextBlock FontSize="34" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}">
                                <TextBlock.Text><Binding Path="TotalIncomeText"/></TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Margin="6,0" Padding="18,18">
                        <StackPanel>
                            <TextBlock Text="总支出" Classes="muted" />
                            <TextBlock FontSize="34" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}">
                                <TextBlock.Text><Binding Path="TotalExpenseText"/></TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card" Margin="6,0,0,0" Padding="18,18">
                        <StackPanel>
                            <TextBlock Text="利润" Classes="muted" />
                            <TextBlock FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}">
                                <TextBlock.Text><Binding Path="ProfitText"/></TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 月度明细（加大字体） -->
                <Border Classes="card" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="月度明细" Classes="sectionTitle" />
                        <ItemsControl ItemsSource="{Binding DetailRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Label}" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{Binding IsIncome, Converter={x:Static vm:BrushConverter.Income}}">
                                                <TextBlock.Text><MultiBinding StringFormat="{}{0:0.##} 元"><Binding Path="Amount"/></MultiBinding></TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
