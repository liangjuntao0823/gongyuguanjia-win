<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.TodosView"
             x:DataType="vm:TodosViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="待办" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ 添加待办" Classes="primary" Click="OnAddTodo" />
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" Watermark="搜索待办" Text="{Binding SearchText}" />
                    <ComboBox Width="110" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatText}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,4" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                                <!-- 完成勾选 -->
                                <ToggleButton Width="34" Height="26" IsChecked="{Binding IsCompleted}" Click="OnToggleComplete" Tag="{Binding}" />
                                <!-- 标题+备注 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Note}" Classes="muted" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ReminderText}" VerticalAlignment="Center" Width="24" Foreground="{DynamicResource WarningBrush}" />
                                <!-- 排序按钮在关闭/删除按钮左边 -->
                                <Button Grid.Column="3" Content="↑" Click="OnMoveUp" Tag="{Binding}" Width="34" Margin="4,0,0,0" />
                                <Button Grid.Column="4" Content="↓" Click="OnMoveDown" Tag="{Binding}" Width="34" Margin="4,0,0,0" />
                                <Button Grid.Column="5" Content="编辑" Click="OnEditTodo" Tag="{Binding}" Margin="8,0,0,0" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="编辑" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                <TextBlock Grid.Column="6" Text="{Binding DueText}" Classes="muted" VerticalAlignment="Center" Width="52" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="7" Text="{Binding CompletedText}" Classes="muted" VerticalAlignment="Center" Width="110" Margin="8,0,0,0" Foreground="{DynamicResource SuccessBrush}" />
                                <Button Grid.Column="7" Content="✕" Click="OnDeleteTodo" Tag="{Binding}" Width="34" Margin="8,0,0,0"
                                        Foreground="{DynamicResource DangerBrush}" Background="Transparent" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
