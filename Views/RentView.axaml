<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.RentView"
             x:DataType="vm:RentViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="收租" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ 新增收租房源" Classes="primary" Click="OnAddProperty"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="新增收租房源" VerticalAlignment="Center" Foreground="White"/></StackPanel></Button>
                    <Button Content="导出 Excel" Click="OnExportExcel"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导出 Excel" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                    <Button Content="导出图片" Click="OnExportImage" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="导出图片" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="110" ItemsSource="{Binding StatusFilter}" SelectedItem="{Binding SelectedStatus}" />
                    <ComboBox Width="110" ItemsSource="{Binding DueDayFilter}" SelectedItem="{Binding SelectedDueDay}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatText}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- 列表式数据行 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,4" Padding="14,10" Background="{DynamicResource CardBackground}">
                            <Grid ColumnDefinitions="Auto,100,90,110,90,90,*" RowDefinitions="Auto,Auto">
                                <TextBlock Text="{Binding RoomNumber}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Width="110" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding UnitType}" Classes="muted" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Landlord}" Classes="muted" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Rent}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding DueDay, StringFormat='{}每{0}日收'}" Classes="muted" VerticalAlignment="Center" />
                                <Border Grid.Column="5" CornerRadius="10" Padding="8,3" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center" Width="70">
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="详情" Click="OnViewDetailBtn" Tag="{Binding Property}" Padding="12,5" FontSize="12" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="详情" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                    <Button Content="编辑" Click="OnEditPropertyBtn" Tag="{Binding Property}" Padding="12,5" FontSize="12" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="编辑" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                    <Button Content="水电结算" Click="OnSettleUtility" Tag="{Binding Property}" Padding="12,5" FontSize="12" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="水电结算" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                    <Button Content="退租" Click="OnTerminate" Tag="{Binding Property}" Padding="12,5" FontSize="12" IsVisible="{Binding Property.IsTerminated, Converter={StaticResource InverseBool}}" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="退租" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                    <Button Content="删除" Click="OnDeletePropertyBtn" Tag="{Binding Property}" Padding="12,5" FontSize="12" Foreground="{DynamicResource DangerBrush}" ><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="删除" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/></StackPanel></Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="7" Text="{Binding Notes}" Classes="muted" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
