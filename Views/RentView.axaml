<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApartmentManagerWin.ViewModels"
             x:Class="ApartmentManagerWin.Views.RentView"
             x:DataType="vm:RentViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="收租" Classes="pageTitle" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ 新增收租房源" Classes="primary" Click="OnAddProperty" />
                    <Button Content="导出 Excel" Click="OnExportExcel" />
                    <Button Content="导出图片" Click="OnExportImage" />
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ComboBox Width="120" ItemsSource="{Binding StatusFilter}" SelectedItem="{Binding SelectedStatus}" />
                <TextBlock Grid.Column="2" Text="{Binding StatText}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- 列表式卡片 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,4" Padding="14,10">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="查看详情" Click="OnViewDetail" Tag="{Binding Property}" />
                                    <MenuItem Header="编辑" Click="OnEditProperty" Tag="{Binding Property}" />
                                    <MenuItem Header="删除" Click="OnDeleteProperty" Tag="{Binding Property}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                <TextBlock Text="{Binding RoomNumber}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Width="110" />
                                <TextBlock Grid.Column="1" Text="{Binding UnitType}" Classes="muted" Width="100" />
                                <TextBlock Grid.Column="2" Text="{Binding Landlord}" Classes="muted" Width="90" />
                                <TextBlock Grid.Column="3" Text="{Binding Rent}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Width="110" />
                                <TextBlock Grid.Column="4" Text="{Binding DueDay, StringFormat='{}每{0}日收'}" Classes="muted" Width="90" />
                                <Border Grid.Column="5" CornerRadius="10" Padding="8,3"
                                        Background="{DynamicResource AccentSoft}">
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Accent}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
